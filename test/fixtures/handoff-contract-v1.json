{
  "$schema": "agenthost-continuity-handoff-fixtures-v1",
  "contractId": "CONT-08",
  "contractVersion": 1,
  "seededSecret": "ah-test-handoff-secret-DO-NOT-LOG",
  "knownAgents": ["claude", "codex", "gemini", "hermes", "kimi"],
  "expectedOutputEnum": ["unified-diff", "review-verdict", "report", "artifact-set", "chat-reply"],
  "reviewRequirementEnum": ["none", "cross-engine", "security"],
  "capabilityEnum": ["chat", "review", "terminal", "unattended", "gitMaxRung:<n>"],
  "terminalStates": ["completed", "rejected", "expired", "cancelled"],
  "serverMintedFields": ["id", "runId", "chainId", "parentHandoffId", "reissuedFrom", "createdAt", "expiresAt", "acceptedBy", "acceptedAt", "acceptanceToken", "effectKey"],
  "derivedCapabilityMap": {
    "chat-reply": "chat",
    "report": "chat",
    "review-verdict": "review"
  },
  "reviewedOutputDerivedCapabilityMap": {
    "unified-diff": "terminal",
    "artifact-set": "terminal"
  },
  "autonomousOutputDerivedCapabilityMap": {
    "unified-diff": "unattended",
    "artifact-set": "unattended"
  },
  "reviewedVsAutonomousNote": "terminal is not an autonomous-execution licence (CONT-06 reconciliation): unified-diff/artifact-set derive 'terminal' only when a human turn will review before landing (autonomous:false); when the target applies/commits/merges with no returning human turn (autonomous:true), the derived capability is 'unattended' so the authorized rung is never bypassed for autonomous work.",
  "limits": {
    "contextSummaryMaxChars": 4000,
    "artifactsMax": 32,
    "expiryWindowMaxSeconds": 86400,
    "reissueMaxPerChain": 3
  },
  "creationCases": [
    {
      "id": "create-valid-review-handoff",
      "accepted": true,
      "request": { "taskId": "CONT-08", "source": "claude", "target": "codex", "contextSummary": "Drafted the handoff contract; needs cross-engine review.", "artifacts": [{ "type": "file", "path": "docs/continuity/HANDOFF-CONTRACT.md", "revision": "aaaaaaa" }], "expectedOutput": "review-verdict", "reviewRequirement": "cross-engine", "expiryWindowSeconds": 3600 },
      "expected": { "state": "pending", "derivedCapability": "review", "acceptedBy": null, "acceptanceToken": null, "effectKey": null }
    },
    {
      "id": "create-valid-diff-handoff-human-reviewed",
      "accepted": true,
      "request": { "taskId": "CONT-05", "source": "codex", "target": "claude", "contextSummary": "Channel backend landed; hand the mobile surface to Claude for a human-reviewed PR.", "artifacts": [{ "type": "file", "path": "container/gate.js", "revision": "093dca4" }], "expectedOutput": "unified-diff", "autonomous": false, "reviewRequirement": "none", "expiryWindowSeconds": 7200 },
      "expected": { "state": "pending", "derivedCapability": "terminal", "acceptedBy": null, "acceptanceToken": null, "effectKey": null }
    },
    {
      "id": "create-valid-diff-handoff-autonomous-needs-unattended",
      "accepted": true,
      "request": { "taskId": "CONT-05", "source": "codex", "target": "hermes", "contextSummary": "Autonomously apply and commit this diff with no returning human turn.", "artifacts": [{ "type": "file", "path": "container/gate.js", "revision": "093dca4" }], "expectedOutput": "unified-diff", "autonomous": true, "reviewRequirement": "none", "expiryWindowSeconds": 7200 },
      "expected": { "state": "pending", "derivedCapability": "unattended", "acceptedBy": null, "acceptanceToken": null, "effectKey": null },
      "note": "CONT-06 reconciliation: autonomous execution requires unattended, not merely terminal, or the authorized rung is bypassed"
    },
    {
      "id": "create-valid-report-handoff-atmax-expiry",
      "accepted": true,
      "request": { "taskId": "CONT-10", "source": "claude", "target": "gemini", "contextSummary": "Summarize the audit window for export.", "expectedOutput": "report", "reviewRequirement": "none", "expiryWindowSeconds": 86400 },
      "expected": { "state": "pending", "derivedCapability": "chat", "acceptedBy": null, "acceptanceToken": null, "effectKey": null }
    },
    {
      "id": "create-valid-artifactset-handoff",
      "accepted": true,
      "request": { "taskId": "CONT-11", "source": "codex", "target": "gemini", "contextSummary": "Produce the voice sample set for human pickup.", "expectedOutput": "artifact-set", "autonomous": false, "reviewRequirement": "none", "expiryWindowSeconds": 1800 },
      "expected": { "state": "pending", "derivedCapability": "terminal" }
    },
    {
      "id": "create-valid-chatreply-handoff",
      "accepted": true,
      "request": { "taskId": "CONT-04", "source": "claude", "target": "gemini", "contextSummary": "Answer the operator question in the inbox thread.", "expectedOutput": "chat-reply", "reviewRequirement": "none", "expiryWindowSeconds": 600 },
      "expected": { "state": "pending", "derivedCapability": "chat" }
    },
    { "id": "reject-server-minted-id-supplied", "accepted": false, "request": { "id": "ho_attacker", "taskId": "CONT-08", "source": "claude", "target": "codex", "expectedOutput": "report", "reviewRequirement": "none", "expiryWindowSeconds": 600 }, "errorCode": "HANDOFF_REQUEST_INVALID", "errorContains": "server-minted" },
    { "id": "reject-server-minted-runid-supplied", "accepted": false, "request": { "runId": "run_victim", "taskId": "CONT-08", "source": "claude", "target": "codex", "expectedOutput": "report", "reviewRequirement": "none", "expiryWindowSeconds": 600 }, "errorCode": "HANDOFF_REQUEST_INVALID", "errorContains": "server-minted" },
    { "id": "reject-server-minted-chainid-supplied", "accepted": false, "request": { "chainId": "chain_victim", "taskId": "CONT-08", "source": "claude", "target": "codex", "expectedOutput": "report", "reviewRequirement": "none", "expiryWindowSeconds": 600 }, "errorCode": "HANDOFF_REQUEST_INVALID", "errorContains": "server-minted" },
    { "id": "reject-server-minted-token-supplied", "accepted": false, "request": { "acceptanceToken": "tok_attacker", "taskId": "CONT-08", "source": "claude", "target": "codex", "expectedOutput": "report", "reviewRequirement": "none", "expiryWindowSeconds": 600 }, "errorCode": "HANDOFF_REQUEST_INVALID", "errorContains": "server-minted" },
    { "id": "reject-server-minted-createdat-supplied", "accepted": false, "request": { "createdAt": "2020-01-01T00:00:00Z", "taskId": "CONT-08", "source": "claude", "target": "codex", "expectedOutput": "report", "reviewRequirement": "none", "expiryWindowSeconds": 600 }, "errorCode": "HANDOFF_REQUEST_INVALID", "errorContains": "server-minted" },
    { "id": "reject-unknown-source-agent", "accepted": false, "request": { "taskId": "CONT-08", "source": "openclaw", "target": "codex", "expectedOutput": "report", "reviewRequirement": "none", "expiryWindowSeconds": 600 }, "errorCode": "UNKNOWN_AGENT", "errorContains": "roster" },
    { "id": "reject-unknown-target-agent", "accepted": false, "request": { "taskId": "CONT-08", "source": "claude", "target": "ollama", "expectedOutput": "report", "reviewRequirement": "none", "expiryWindowSeconds": 600 }, "errorCode": "UNKNOWN_AGENT", "errorContains": "roster" },
    { "id": "reject-unknown-expected-output", "accepted": false, "request": { "taskId": "CONT-08", "source": "claude", "target": "codex", "expectedOutput": "shell-access", "reviewRequirement": "none", "expiryWindowSeconds": 600 }, "errorCode": "HANDOFF_REQUEST_INVALID", "errorContains": "expectedOutput" },
    { "id": "reject-freetext-taskid", "accepted": false, "request": { "taskId": "please just fix the thing", "source": "claude", "target": "codex", "expectedOutput": "report", "reviewRequirement": "none", "expiryWindowSeconds": 600 }, "errorCode": "HANDOFF_REQUEST_INVALID", "errorContains": "taskId" },
    { "id": "reject-missing-required-field", "accepted": false, "request": { "taskId": "CONT-08", "target": "codex", "expectedOutput": "report", "reviewRequirement": "none", "expiryWindowSeconds": 600 }, "errorCode": "HANDOFF_REQUEST_INVALID", "errorContains": "source" },
    { "id": "reject-capability-hint-weaker-than-derived", "accepted": false, "request": { "taskId": "CONT-08", "source": "claude", "target": "codex", "expectedOutput": "review-verdict", "capabilityHint": "chat", "reviewRequirement": "cross-engine", "expiryWindowSeconds": 600 }, "errorCode": "HANDOFF_REQUEST_INVALID", "errorContains": "capability" },
    { "id": "reject-out-of-enum-capability-hint", "accepted": false, "request": { "taskId": "CONT-08", "source": "claude", "target": "codex", "expectedOutput": "report", "capabilityHint": "root", "reviewRequirement": "none", "expiryWindowSeconds": 600 }, "errorCode": "HANDOFF_REQUEST_INVALID", "errorContains": "capability" },
    { "id": "reject-out-of-enum-review-requirement", "accepted": false, "request": { "taskId": "CONT-08", "source": "claude", "target": "codex", "expectedOutput": "report", "reviewRequirement": "rubber-stamp", "expiryWindowSeconds": 600 }, "errorCode": "HANDOFF_REQUEST_INVALID", "errorContains": "reviewRequirement" },
    { "id": "reject-context-too-large", "accepted": false, "request": { "taskId": "CONT-08", "source": "claude", "target": "codex", "contextSummaryLength": 4001, "expectedOutput": "report", "reviewRequirement": "none", "expiryWindowSeconds": 600 }, "errorCode": "CONTEXT_TOO_LARGE", "errorContains": "summary" },
    { "id": "reject-too-many-artifacts", "accepted": false, "request": { "taskId": "CONT-08", "source": "claude", "target": "codex", "artifactCount": 33, "expectedOutput": "artifact-set", "reviewRequirement": "none", "expiryWindowSeconds": 600 }, "errorCode": "HANDOFF_REQUEST_INVALID", "errorContains": "artifact" },
    { "id": "reject-nonpositive-expiry-window", "accepted": false, "request": { "taskId": "CONT-08", "source": "claude", "target": "codex", "expectedOutput": "report", "reviewRequirement": "none", "expiryWindowSeconds": 0 }, "errorCode": "HANDOFF_REQUEST_INVALID", "errorContains": "expiry" },
    { "id": "reject-expiry-window-too-long", "accepted": false, "request": { "taskId": "CONT-08", "source": "claude", "target": "codex", "expectedOutput": "report", "reviewRequirement": "none", "expiryWindowSeconds": 86401 }, "errorCode": "HANDOFF_REQUEST_INVALID", "errorContains": "expiry" },
    { "id": "reject-self-review-same-agent-crossengine", "accepted": false, "request": { "taskId": "CONT-08", "source": "codex", "target": "codex", "expectedOutput": "review-verdict", "reviewRequirement": "cross-engine", "expiryWindowSeconds": 600 }, "errorCode": "SELF_REVIEW_FORBIDDEN", "errorContains": "review" },
    { "id": "reject-self-review-same-agent-none", "accepted": false, "request": { "taskId": "CONT-08", "source": "codex", "target": "codex", "expectedOutput": "review-verdict", "reviewRequirement": "none", "expiryWindowSeconds": 600 }, "errorCode": "SELF_REVIEW_FORBIDDEN", "errorContains": "review", "note": "reviewRequirement:none must not smuggle a self-review of review-shaped work" },
    { "id": "reject-self-review-security", "accepted": false, "request": { "taskId": "CONT-08", "source": "codex", "target": "codex", "expectedOutput": "review-verdict", "reviewRequirement": "security", "expiryWindowSeconds": 600 }, "errorCode": "SELF_REVIEW_FORBIDDEN", "errorContains": "review" },
    { "id": "reject-self-review-resolved-authorship", "accepted": false, "request": { "taskId": "CONT-08", "source": "claude", "target": "codex", "artifacts": [{ "type": "file", "path": "container/providers-lib.js", "revision": "093dca4" }], "expectedOutput": "review-verdict", "reviewRequirement": "cross-engine", "expiryWindowSeconds": 600 }, "ledgerAuthorOfArtifact": "codex", "errorCode": "SELF_REVIEW_FORBIDDEN", "errorContains": "author", "note": "authorship resolved server-side from ledger; target==resolved author" },
    { "id": "reject-self-review-unresolvable-authorship-failsclosed", "accepted": false, "request": { "taskId": "CONT-08", "source": "claude", "target": "codex", "artifacts": [{ "type": "file", "path": "container/providers-lib.js", "revision": "093dca4" }], "expectedOutput": "review-verdict", "reviewRequirement": "cross-engine", "expiryWindowSeconds": 600 }, "ledgerAuthorOfArtifact": null, "authorshipResolvable": false, "errorCode": "SELF_REVIEW_FORBIDDEN", "errorContains": "author", "note": "ledger BLOCKED / authorship unresolvable -> fails closed to SELF_REVIEW_FORBIDDEN, never accepts on unknown authorship" },
    { "id": "reject-budget-reservation-over-standing", "accepted": false, "request": { "taskId": "CONT-07", "source": "claude", "target": "codex", "expectedOutput": "report", "reviewRequirement": "none", "budgetReservation": { "maxCostUsd": 50.0 }, "expiryWindowSeconds": 600 }, "targetStandingBudgetUsd": 5.0, "errorCode": "BUDGET_RESERVATION_INVALID", "errorContains": "budget" },
    { "id": "reject-budget-reservation-over-effective-cap", "accepted": false, "request": { "taskId": "CONT-07", "source": "claude", "target": "codex", "expectedOutput": "report", "reviewRequirement": "none", "budgetReservation": { "maxCostUsd": 0.8 }, "expiryWindowSeconds": 600 }, "targetStandingBudgetUsd": 5.0, "targetPerTaskCapUsd": 0.2, "errorCode": "BUDGET_RESERVATION_INVALID", "errorContains": "budget", "note": "0.8 <= standing 5.0 but > effective per-task cap 0.2" },
    { "id": "reject-budget-reservation-over-held-total", "accepted": false, "request": { "taskId": "CONT-07", "source": "claude", "target": "codex", "expectedOutput": "report", "reviewRequirement": "none", "budgetReservation": { "maxCostUsd": 0.8 }, "expiryWindowSeconds": 600 }, "targetStandingBudgetUsd": 1.0, "alreadyHeldUsd": 0.8, "errorCode": "BUDGET_RESERVATION_INVALID", "errorContains": "budget", "note": "each <= 1.0 but concurrent hold 0.8+0.8 > 1.0" },
    { "id": "reject-budget-reservation-over-token-cap", "accepted": false, "request": { "taskId": "CONT-07", "source": "claude", "target": "codex", "expectedOutput": "report", "reviewRequirement": "none", "budgetReservation": { "maxTokens": 5000000 }, "expiryWindowSeconds": 600 }, "targetStandingTokens": 1200000, "errorCode": "BUDGET_RESERVATION_INVALID", "errorContains": "budget" },
