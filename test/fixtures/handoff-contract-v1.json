    { "id": "artifact-revision-changed-at-completion", "artifact": { "type": "file", "path": "container/gate.js", "revision": "093dca4" }, "resolves": true, "revisionMatchesAtAcceptance": true, "revisionMatchesAtCompletion": false, "expected": { "completed": false, "errorCode": "ARTIFACT_REVISION_CHANGED" }, "note": "pin re-validated at completion; receiver read the immutable object, not the moved working path" }
