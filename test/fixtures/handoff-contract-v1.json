    { "id": "reject-artifact-absolute-path", "accepted": false, "request": { "taskId": "CONT-08", "source": "claude", "target": "codex", "artifacts": [{ "type": "file", "path": "/etc/passwd", "revision": "093dca4" }], "expectedOutput": "review-verdict", "reviewRequirement": "cross-engine", "expiryWindowSeconds": 600 }, "errorCode": "HANDOFF_REQUEST_INVALID", "errorContains": "path" },
    { "id": "reject-artifact-symlink-escape", "accepted": false, "request": { "taskId": "CONT-08", "source": "claude", "target": "codex", "artifacts": [{ "type": "file", "path": "container/evil-link", "revision": "093dca4" }], "symlinkEscapes": true, "expectedOutput": "review-verdict", "reviewRequirement": "cross-engine", "expiryWindowSeconds": 600 }, "errorCode": "HANDOFF_REQUEST_INVALID", "errorContains": "path" }
  ],
  "derivedCapabilityCases": [
    { "id": "derive-review", "expectedOutput": "review-verdict", "expectedCapability": "review" },
    { "id": "derive-terminal-diff-reviewed", "expectedOutput": "unified-diff", "autonomous": false, "expectedCapability": "terminal" },
    { "id": "derive-terminal-artifactset-reviewed", "expectedOutput": "artifact-set", "autonomous": false, "expectedCapability": "terminal" },
    { "id": "derive-unattended-diff-autonomous", "expectedOutput": "unified-diff", "autonomous": true, "expectedCapability": "unattended" },
    { "id": "derive-unattended-artifactset-autonomous", "expectedOutput": "artifact-set", "autonomous": true, "expectedCapability": "unattended" },
    { "id": "derive-chat-report", "expectedOutput": "report", "expectedCapability": "chat" },
    { "id": "derive-chat-reply", "expectedOutput": "chat-reply", "expectedCapability": "chat" }
  ],
  "acceptanceCases": [
    { "id": "accept-once-success", "handoff": { "target": "codex", "derivedCapability": "review", "state": "pending" }, "callerIdentity": "codex", "targetCapabilityAvailable": true, "expected": { "accepted": true, "state": "accepted", "mintsToken": true, "recordsEffectKeyBeforeEffect": true, "duplicate": false } },
    { "id": "accept-by-non-target-blocked", "handoff": { "target": "codex", "derivedCapability": "review", "state": "pending" }, "callerIdentity": "claude", "targetCapabilityAvailable": true, "expected": { "accepted": false, "errorCode": "ACCEPTOR_NOT_TARGET", "mintsToken": false }, "note": "confused deputy: only the authenticated target may accept" },
    { "id": "accept-duplicate-blocked", "handoff": { "target": "codex", "derivedCapability": "review", "state": "accepted", "acceptanceToken": "tok_existing" }, "callerIdentity": "codex", "targetCapabilityAvailable": true, "attempt": 2, "expected": { "accepted": false, "errorCode": "DUPLICATE_ACCEPTANCE", "mintsToken": false } },
    { "id": "accept-restart-idempotent-replay", "handoff": { "target": "codex", "derivedCapability": "review", "state": "accepted", "acceptanceToken": "tok_existing" }, "callerIdentity": "codex", "targetCapabilityAvailable": true, "replayOfSameAccept": true, "expected": { "accepted": true, "state": "accepted", "mintsToken": false, "returnsSameToken": "tok_existing" } },
    { "id": "effect-idempotent-after-crash", "handoff": { "target": "codex", "derivedCapability": "terminal", "state": "accepted", "acceptanceToken": "tok_existing", "effectKey": "eff_existing" }, "crashBetweenEffectAndCompletion": true, "expected": { "reEmitsEffect": false, "returnsRecordedResult": true, "usesEffectKey": "eff_existing" }, "note": "single-acceptance protects accept; effectKey protects the effect" },
    { "id": "accept-after-expiry-blocked", "handoff": { "target": "codex", "derivedCapability": "review", "state": "pending" }, "callerIdentity": "codex", "targetCapabilityAvailable": true, "nowAfterAcceptDeadline": true, "expected": { "accepted": false, "errorCode": "HANDOFF_EXPIRED", "mintsToken": false, "state": "expired" } },
    { "id": "accept-target-unavailable-blocked", "handoff": { "target": "codex", "derivedCapability": "review", "state": "pending" }, "callerIdentity": "codex", "targetOnline": false, "expected": { "accepted": false, "errorCode": "TARGET_UNAVAILABLE", "mintsToken": false } },
    { "id": "accept-capability-lost-after-creation-blocked", "handoff": { "target": "codex", "derivedCapability": "unattended", "state": "pending", "capabilityAtCreation": "available" }, "callerIdentity": "codex", "targetCapabilityAvailable": false, "expected": { "accepted": false, "errorCode": "CAPABILITY_UNAVAILABLE", "mintsToken": false } },
    { "id": "capability-revoked-at-effect-blocked", "handoff": { "target": "codex", "derivedCapability": "unattended", "state": "accepted", "acceptanceToken": "tok_existing" }, "callerIdentity": "codex", "capabilityAtAcceptance": true, "capabilityAtEffect": false, "expected": { "effectEmitted": false, "errorCode": "CAPABILITY_UNAVAILABLE", "state": "blocked" }, "note": "TOCTOU: re-check derived capability at effect emission, not only acceptance" },
    { "id": "accept-gitrung-level-sufficient", "handoff": { "target": "codex", "derivedCapability": "gitMaxRung:2", "state": "pending" }, "callerIdentity": "codex", "targetProfileGitRung": { "state": "available", "value": 3 }, "expected": { "accepted": true, "state": "accepted" } },
    { "id": "accept-gitrung-level-insufficient-blocked", "handoff": { "target": "codex", "derivedCapability": "gitMaxRung:5", "state": "pending" }, "callerIdentity": "codex", "targetProfileGitRung": { "state": "available", "value": 2 }, "expected": { "accepted": false, "errorCode": "CAPABILITY_UNAVAILABLE", "mintsToken": false }, "note": "boolean has-gitMaxRung is insufficient; require value >= n" },
    { "id": "accept-kimi-review-unavailable-from-profile", "handoff": { "target": "kimi", "derivedCapability": "review", "state": "pending" }, "callerIdentity": "kimi", "targetProfileCapabilities": { "chat": "unavailable", "review": "unavailable", "terminal": "unavailable" }, "expected": { "accepted": false, "errorCode": "CAPABILITY_UNAVAILABLE", "mintsToken": false }, "note": "unavailability derives from the live kimi profile, not from prose" },
    { "id": "accept-kimi-chat-unavailable-baseline", "handoff": { "target": "kimi", "derivedCapability": "chat", "state": "pending" }, "callerIdentity": "kimi", "targetProfileCapabilities": { "chat": "unavailable" }, "expected": { "accepted": false, "errorCode": "CAPABILITY_UNAVAILABLE", "mintsToken": false }, "note": "current baseline: kimi chat is NOT_WIRED, so even chat is unavailable" }
  ],
  "artifactCases": [
