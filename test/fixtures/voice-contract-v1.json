    { "id": "envelope-error-capture-interrupted", "code": "CAPTURE_INTERRUPTED", "expected": { "status": "error", "summary": "The recording was interrupted before it finished.", "next_actions": ["Record again."], "artifacts": [], "error": { "code": "CAPTURE_INTERRUPTED", "retry": "Start a new push-to-talk capture.", "stopCondition": "Do not dispatch an interrupted capture." } } },
    { "id": "envelope-error-speaker-not-authenticated", "code": "SPEAKER_NOT_AUTHENTICATED", "expected": { "status": "error", "summary": "The speaker is not authenticated as the operator.", "next_actions": [], "artifacts": [], "error": { "code": "SPEAKER_NOT_AUTHENTICATED", "retry": "Sign in as the operator, then use voice.", "stopCondition": "Never dispatch a voice turn under the operator's authority without authenticating the speaker." } } }
