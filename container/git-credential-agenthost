#!/bin/sh
# Git credential helper for Phase 3. The scoped token is supplied on file
# descriptor 3 by a future isolated push broker. It is deliberately never read
# from an environment variable or written to disk.
set -eu

case "${1:-}" in
  get)
    protocol=""
    host=""
    request_path=""
    while IFS= read -r line; do
      [ -n "$line" ] || break
      case "$line" in
        protocol=*) protocol="${line#protocol=}" ;;
        host=*) host="${line#host=}" ;;
        path=*) request_path="${line#path=}" ;;
      esac
    done
    # The gate supplies the exact non-secret GitHub path for this one clean
    # transport. A redirect or future URL regression must not receive the PAT.
    [ "$protocol" = "https" ] || exit 1
    [ "$host" = "github.com" ] || exit 1
    [ -n "${AGENTHOST_GIT_CREDENTIAL_PATH:-}" ] || exit 1
    [ "$request_path" = "$AGENTHOST_GIT_CREDENTIAL_PATH" ] || exit 1
    IFS= read -r token <&3
    [ -n "$token" ] || exit 1
    printf 'username=x-access-token\npassword=%s\n' "$token"
    ;;
  store|erase)
    # Credentials are ephemeral. Never persist them.
    ;;
  *)
    exit 1
    ;;
esac
